# Copy to `.dev.vars` for local development.
# Rate-limit bindings (including FRIENDSHIP_RATE_LIMITER) are configured in
# wrangler.jsonc and need no secret value here.
#
# @opennextjs/cloudflare layers this file over the `vars` block in
# wrangler.jsonc. Without it BETTER_AUTH_URL falls back to the production
# value there, so local verification links point at the deployed site.

BETTER_AUTH_URL=http://localhost:3000

# Signs session cookies. better-auth warns below 32 characters. Changing it
# invalidates existing local sessions. Never use this value in production.
BETTER_AUTH_SECRET=local-development-only-secret-not-for-production

# Leave empty to log emails locally, including verification/reset links, when
# BETTER_AUTH_URL uses localhost, 127.0.0.1, or [::1]. Other origins require a key.
RESEND_API_KEY=

# Google OAuth (optional for local dev, https://console.cloud.google.com/apis/credentials)
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google (dev)
#   https://betabook.ca/api/auth/callback/google   (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Turnstile is off unless both are set. Cloudflare's always-pass test keys are
# 1x00000000000000000000AA (site) and 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Live usage on /costs is off unless both are set; the page then lists only the
# fixed bills. The token needs Account Analytics Read on this account.
CLOUDFLARE_USAGE_ACCOUNT_ID=
CLOUDFLARE_USAGE_API_TOKEN=
