{
  "compilerOptions": {
    "target": "ESNext",
    // Deliberately not "esnext": one tsconfig covers server and client code, so
    // the floor here is what the browsers in package.json#browserslist support.
    // Nothing polyfills built-ins, so an ES2024 method (Object.groupBy,
    // Promise.withResolvers) would ship as-is and throw on Safari 16.4.
    "lib": ["dom", "dom.iterable", "ES2023"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // scripts/ run under `node scripts/x.ts` (type stripping), which resolves
    // only explicit .ts specifiers.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // `pnpm seed` runs scripts/*.ts through node's type stripping, which
    // can only erase syntax (no enums, namespaces, parameter properties).
    "erasableSyntaxOnly": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@/app/*": ["./test/reference/app/*"],
      "@/actions": ["./test/reference/actions/index.ts"],
      "@/actions/*": ["./test/reference/actions/*"],
      "@/db/*": ["./test/reference/db/*"],
      "@/drizzle/schema": ["./test/reference/drizzle/schema/index.ts"],
      "@/drizzle/schema/*": ["./test/reference/drizzle/schema/*"],
      "@/lib/*": ["./frontend/src/lib/*", "./test/reference/lib/*"],
      "@/test/*": ["./test/*", "./test/reference/test/*"],
      "@/tests/*": ["./tests/*"],
      "@/stories/*": ["./frontend/stories/*"],
      "@/.storybook/*": ["./frontend/.storybook/*"],
      "@/shared/*": ["./shared/*"],
      "@/drizzle/migrations/*": ["./backend/migrations/*"],
      "@/*": ["./frontend/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": ["node_modules", ".claude"]
}
