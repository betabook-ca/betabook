{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortImports": true,
  "sortPackageJson": true,
  "sortTailwindcss": {
    "functions": ["clsx"],
    "stylesheet": "frontend/src/spa/globals.css"
  },
  "ignorePatterns": [
    "api/openapi.json",
    "frontend/src/spa/generated/api.d.ts",
    ".next/**",
    "out/**",
    "build/**",
    "dist/**",
    ".open-next/**",
    ".wrangler/**",
    "climbs_data/**",
    ".claude/**",
    ".agents/skills/github-upload-image-to-pr/**",
    "backend/migrations/**",
    "worker-configuration.d.ts",
    "next-env.d.ts",
    "pnpm-lock.yaml",
    "storybook-static/**",
    "playwright-report/**",
    "test-results/**",
    "target/**",
    "backend/**",
    "dist-spa/**",
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml"
  ]
}
