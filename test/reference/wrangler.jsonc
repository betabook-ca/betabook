{
  "name": "betabook-reference-tests",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:3000",
    "BETTER_AUTH_SECRET": "local-test-secret-for-reference-fixtures-only",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "betabook-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "r2_buckets": [
    { "binding": "PROFILE_PHOTOS", "bucket_name": "test-avatars" },
    { "binding": "CATALOG_EXPORTS", "bucket_name": "test-exports" },
  ],
  "images": { "binding": "IMAGES" },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 },
    },
    {
      "name": "JOURNAL_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "FRIENDSHIP_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "PROFILE_PHOTO_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "CLIMB_LIST_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "CLIENT_ERROR_RATE_LIMITER",
      "namespace_id": "1006",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
}
