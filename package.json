{
  "name": "betabook",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "mise run dev",
    "dev:spa": "vite --config frontend/vite.config.ts",
    "build": "node scripts/build-app.ts",
    "build:spa": "node scripts/build-app.ts --spa-only",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "deadcode": "knip",
    "deadcode:prod": "knip --production",
    "typecheck": "tsrs --noEmit -p tsconfig.json",
    "check": "pnpm lint && pnpm format:check && pnpm deadcode && pnpm typecheck && pnpm test",
    "preview": "wrangler dev --config wrangler.jsonc --local --infer-origin-from-routes=false",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "cf-typegen": "wrangler types -c wrangler.jsonc",
    "db:generate": "wrangler d1 migrations create DB --config wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply DB --local -c wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote -c wrangler.jsonc",
    "test": "vitest run",
    "test:rust-worker": "node --test tests/worker/worker.test.ts",
    "test:components": "vitest run --project=components",
    "test:seed-social": "node --disable-warning=ExperimentalWarning scripts/check-social-seed.ts",
    "test:seed-trips": "node --disable-warning=ExperimentalWarning scripts/check-trip-seed.ts",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.ts",
    "setup": "node scripts/setup.ts",
    "promote-admin": "node --disable-warning=ExperimentalWarning scripts/promote-admin.ts",
    "prepare": "husky",
    "storybook": "storybook dev --config-dir frontend/.storybook --host 127.0.0.1 -p 6006 --no-open",
    "storybook:build": "storybook build --config-dir frontend/.storybook --output-dir storybook-static --disable-telemetry",
    "test:ui": "pnpm storybook:build && playwright test",
    "brand:generate": "node scripts/generate-brand-assets.ts",
    "chromatic": "chromatic",
    "api:generate": "node scripts/generate-api.ts",
    "api:check": "node scripts/generate-api.ts --check"
  },
  "dependencies": {
    "@heroui/react": "3.2.8",
    "@heroui/styles": "3.2.8",
    "@internationalized/date": "3.12.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "html-entities": "^2.6.0",
    "lucide-react": "^1.78.0",
    "papaparse": "^5.7.1",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-easy-crop": "6.2.5",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.2",
    "recharts": "^3.11.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "^5.20261124.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "1.65.1",
    "@storybook/addon-mcp": "10.6.8",
    "@storybook/react-vite": "10.6.8",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "chromatic": "18.15.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "jsqr": "1.4.0",
    "knip": "^6.48.0",
    "lint-staged": "^17.6.2",
    "openapi-typescript": "7.13.0",
    "oxc-transform-react": "0.158.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tailwindcss": "^1.17.2",
    "storybook": "10.6.8",
    "tailwindcss": "^4.3.5",
    "tsrs": "^7.1.0-beta.tsrs4",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 115",
    "safari 16.4"
  ],
  "packageManager": "pnpm@12.21.0"
}
