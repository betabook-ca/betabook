{
  "name": "betabook",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "deadcode": "knip",
    "deadcode:prod": "knip --production",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.typecheck.json",
    "check": "pnpm lint && pnpm format:check && pnpm deadcode && pnpm typecheck && pnpm test",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types -c wrangler.jsonc",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local -c wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote -c wrangler.jsonc",
    "test": "vitest run",
    "test:components": "vitest run --project=components",
    "test:seed-social": "node --disable-warning=ExperimentalWarning scripts/check-social-seed.ts",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.ts",
    "setup": "node scripts/setup.ts",
    "promote-admin": "node --disable-warning=ExperimentalWarning scripts/promote-admin.ts",
    "prepare": "husky",
    "storybook": "storybook dev --host 127.0.0.1 -p 6006 --no-open",
    "storybook:build": "storybook build --disable-telemetry",
    "test:ui": "pnpm storybook:build && playwright test",
    "brand:generate": "node scripts/generate-brand-assets.ts",
    "brand:og-fonts": "node scripts/generate-og-fonts.ts",
    "chromatic": "chromatic"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.30",
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "@internationalized/date": "3.12.4",
    "better-auth": "^1.6.30",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "html-entities": "^2.6.0",
    "lucide-react": "^1.31.0",
    "papaparse": "^5.6.0",
    "react": "19.2.8",
    "react-aria-components": "1.20.0",
    "react-dom": "19.2.8",
    "react-easy-crop": "6.2.3",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.22.0",
    "uqr": "0.1.3",
    "vinext": "1.0.0-beta.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "^1.60.2",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-mcp": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vinext/cloudflare": "1.0.0-beta.10",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "chromatic": "18.9.4",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "jsqr": "1.4.0",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "next": "16.3.3",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tailwindcss": "^1.12.0",
    "oxlint-tsgolint": "^7.0.2002",
    "storybook": "10.6.0",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.141.0"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 115",
    "safari 16.4"
  ],
  "packageManager": "pnpm@11.25.0"
}
