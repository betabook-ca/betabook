{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "betabook-rust",
  "main": "build/index.js",
  "compatibility_date": "2026-08-17",
  "placement": {
    "mode": "smart"
  },
  "build": {
    "command": "if [ -d crates/betabook-worker ]; then cd crates/betabook-worker; fi && worker-build --release"
  },
  "routes": [
    {
      "pattern": "betabook.ca",
      "custom_domain": true
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://betabook.ca"
  },
  "triggers": {
    "crons": ["0 6 * * 1"]
  },
  "r2_buckets": [
    {
      "binding": "CATALOG_EXPORTS",
      "bucket_name": "betabook-exports"
    },
    {
      "binding": "PROFILE_PHOTOS",
      "bucket_name": "betabook-avatars"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "betabook-db",
      "database_id": "696bc9d0-52b8-4f50-8f4a-41e534000313",
      "migrations_dir": "../../drizzle/migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "JOURNAL_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "FRIENDSHIP_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "CLIMB_LIST_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "PROFILE_PHOTO_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "CLIENT_ERROR_RATE_LIMITER",
      "namespace_id": "1006",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.1
    }
  }
}
