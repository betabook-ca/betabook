{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "betabook",
  "dev": { "port": 3000 },
  "main": "backend/worker/build/index.js",
  "compatibility_date": "2026-08-17",
  "build": {
    "command": "node scripts/build-app.ts --wrangler",
    "watch_dir": [
      "backend/worker/src",
      "backend/domain/src",
      "backend/db/src",
      "backend/worker/Cargo.toml",
      "backend/domain/Cargo.toml",
      "backend/db/Cargo.toml",
      "rust-toolchain.toml",
      "mise.toml",
      "frontend/src",
      "frontend/public",
      "frontend/postcss.config.mjs",
      "frontend/paths.ts",
      "shared",
      "openapi.json",
      "scripts/static-documents.tsx",
      "scripts/public-entry-template.ts",
      "scripts/build-app.ts",
      "package.json",
      "pnpm-lock.yaml",
      "Cargo.toml",
      "Cargo.lock",
      "frontend/vite.config.ts",
    ],
  },
  "placement": {
    "mode": "smart",
  },
  // Vite supplies the SPA shell, code-split chunks and published document bodies.
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist-spa",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/branding/*",
      "!/favicon.ico",
      "!/apple-icon.png",
      "!/icon.svg",
      "!/opengraph-image.png",
      "!/manifest.webmanifest",
      "!/openapi.json",
      "!/license.txt",
      "!/sw.js",
    ],
    "not_found_handling": "none",
  },
  "routes": [
    {
      "pattern": "betabook.ca",
      "custom_domain": true,
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://betabook.ca",
    // Contact push services see on VAPID tokens. VAPID_PRIVATE_KEY is a secret.
    "VAPID_SUBJECT": "https://betabook.ca",
  },
  // Weekly public catalog snapshot (areas + climbs) → R2, served from
  // /account. Mondays 06:00 UTC; see lib/catalog-export.ts.
  "triggers": {
    "crons": ["0 6 * * 1"],
  },
  // Both buckets are created by OpenTofu (infra/cloudflare/r2.tf) and bound
  // here by name; `wrangler deploy` validates the binding, so the Spacelift
  // apply must land first. CATALOG_EXPORTS holds the public catalog
  // snapshot; PROFILE_PHOTOS holds one square WebP per climber.
  "r2_buckets": [
    {
      "binding": "CATALOG_EXPORTS",
      "bucket_name": "betabook-exports",
    },
    {
      "binding": "PROFILE_PHOTOS",
      "bucket_name": "betabook-avatars",
    },
  ],
  // Re-encodes an uploaded profile photo to the one size and format the app
  // stores. Needs no provisioning and no subscription: the first 5,000
  // unique transformations each month are free, and the upload path spends
  // exactly one per photo. Wrangler and the Workers Vitest pool substitute
  // an offline implementation supporting width, height, rotate and format —
  // which is all this app asks of it, so local runs behave like production.
  "images": {
    "binding": "IMAGES",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "betabook-db",
      "database_id": "696bc9d0-52b8-4f50-8f4a-41e534000313",
      "migrations_dir": "backend/migrations",
    },
  ],
  // Throttles the public /contact form, the one write path in the app that
  // doesn't require a session. Counters live at Cloudflare's edge — no table,
  // no cleanup. Two limits of this binding, both accepted deliberately:
  //   - `period` is a hard enum of 10 or 60 seconds, so "N per hour" can't be
  //     expressed here. If 3/min ever proves too generous, the answer is a
  //     dashboard WAF rate limiting rule (1h/24h windows, no code), not a
  //     counter table.
  //   - Limits are per Cloudflare location, so a distributed sender gets
  //     3/min per colo. This exists to cap one bored person; the honeypot in
  //     lib/contact.ts covers the ordinary bot traffic.
  // `namespace_id` is any positive integer unique within the account and
  // needs no provisioning — a deploy creates it.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60,
      },
    },
    {
      "name": "JOURNAL_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60,
      },
    },
    {
      "name": "FRIENDSHIP_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
    // Saved climb lists, apart from the journal: adding climbs one after
    // another from the Add climbs dialog is a burst of quick writes.
    {
      "name": "CLIMB_LIST_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
    // A photo upload spends an Images transformation out of a monthly free
    // allowance and two R2 operations, so this is the one write where the
    // limit protects a budget rather than the database. Five a minute is
    // more re-crops than anyone makes by hand.
    {
      "name": "PROFILE_PHOTO_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
    // /api/client-errors takes a report from any browser that shows an error
    // page, signed in or not. Ten a minute per address is more error pages
    // than one person sees, and it keeps a script from flooding the logs.
    {
      "name": "CLIENT_ERROR_RATE_LIMITER",
      "namespace_id": "1006",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    // From Dec 1, 2026, Workers observability is billed per uncompressed GB:
    // 50 GB ingested and 10 GB-month stored are included, then $0.25/GB and
    // $0.10/GB-month. Trace spans are ~90% of Betabook's volume (~12 spans,
    // ~24 KB a request; ~52 GB a month at 100%). At 10% the total is ~10 GB a
    // month, so traffic can grow ~4x before any charge. Logs, including the
    // request_error and client_error events, stay at 100%: an error is never
    // sampled away. To debug a slow route, set this to 1 for a few days.
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.1,
    },
  },
}
