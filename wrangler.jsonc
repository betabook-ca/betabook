{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "betabook",
  // Checked-in entrypoint that re-exports the generated OpenNext `fetch` and
  // adds the cron `scheduled()` handler; `.open-next/worker.js` is rebuilt
  // from a template on every build, so it cannot hold app code.
  "main": "./worker.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "routes": [
    {
      "pattern": "betabook.ca",
      "custom_domain": true,
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://betabook.ca",
  },
  // Weekly public catalog snapshot (areas + climbs) → R2, served from
  // /account. Mondays 06:00 UTC; see lib/catalog-export.ts.
  "triggers": {
    "crons": ["0 6 * * 1"],
  },
  // Both buckets are created by OpenTofu (infra/cloudflare/r2.tf) and bound
  // here by name; `wrangler deploy` validates the binding, so the Spacelift
  // apply must land first. CATALOG_EXPORTS holds the public catalog
  // snapshot; PROFILE_PHOTOS holds one square WebP per climber.
  "r2_buckets": [
    {
      "binding": "CATALOG_EXPORTS",
      "bucket_name": "betabook-exports",
    },
    {
      "binding": "PROFILE_PHOTOS",
      "bucket_name": "betabook-avatars",
    },
  ],
  // Re-encodes an uploaded profile photo to the one size and format the app
  // stores. Needs no provisioning and no subscription: the first 5,000
  // unique transformations each month are free, and the upload path spends
  // exactly one per photo. Wrangler and the Workers Vitest pool substitute
  // an offline implementation supporting width, height, rotate and format —
  // which is all this app asks of it, so local runs behave like production.
  "images": {
    "binding": "IMAGES",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "betabook-db",
      "database_id": "696bc9d0-52b8-4f50-8f4a-41e534000313",
      "migrations_dir": "drizzle/migrations",
    },
  ],
  // Throttles the public /contact form, the one write path in the app that
  // doesn't require a session. Counters live at Cloudflare's edge — no table,
  // no cleanup. Two limits of this binding, both accepted deliberately:
  //   - `period` is a hard enum of 10 or 60 seconds, so "N per hour" can't be
  //     expressed here. If 3/min ever proves too generous, the answer is a
  //     dashboard WAF rate limiting rule (1h/24h windows, no code), not a
  //     counter table.
  //   - Limits are per Cloudflare location, so a distributed sender gets
  //     3/min per colo. This exists to cap one bored person; the honeypot in
  //     lib/contact.ts covers the ordinary bot traffic.
  // `namespace_id` is any positive integer unique within the account and
  // needs no provisioning — a deploy creates it.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60,
      },
    },
    {
      "name": "JOURNAL_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60,
      },
    },
    {
      "name": "FRIENDSHIP_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
    // A photo upload spends an Images transformation out of a monthly free
    // allowance and two R2 operations, so this is the one write where the
    // limit protects a budget rather than the database. Five a minute is
    // more re-crops than anyone makes by hand.
    {
      "name": "PROFILE_PHOTO_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
